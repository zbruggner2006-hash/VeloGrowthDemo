# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to GitHub.

# Twilio (from console.twilio.com dashboard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# The business owner's real cell phone - calls get forwarded here first
OWNER_PHONE_NUMBER=+15559876543

# Anthropic (from console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cal.com booking link - sent to leads once qualified
CAL_COM_BOOKING_LINK=https://cal.com/yourname/consultation

# Business name - used in the AI's conversation so it sounds like a real receptionist
BUSINESS_NAME=Your Business Name

# Server port (Railway sets this automatically, this is just a local fallback)
PORT=3000

# Optional: a Google Apps Script Web App URL to log leads to a Google Sheet.
# Leave blank to just log leads to a local leads.json file instead.
GOOGLE_SHEETS_WEBHOOK_URL=
